/*
 * Dark Modern Theme for UniPanel - v4 (Dynamic Fonts)
 *
 * Color Palette:
 * @bg-darkest: #233140 (Main Container bg)
 * @bg-dark:    #2c3e50 (Widget bg, Borders)
 * @bg-medium:  #34495e (Inputs, Item Views)
 * @bg-light:   #4a637a (Scrollbars, Hover effects)
 *
 * @text-light: #ecf0f1 (Primary text)
 * @text-white: #ffffff (Button text)
 *
 * @accent-blue:  #3498db (Primary actions)
 * @accent-green: #2ecc71 (Success, Run)
 * @accent-red:   #e74c3c (Danger, Stop, Delete)
 * @accent-orange:#f39c12 (Warning, Restart)
 */

/* Global Reset */
QWidget {
    color: #ecf0f1;
    /* font-family and font-size removed to allow dynamic control via QApplication.setFont */
    background-color: transparent; /* Default transparent to allow container to handle bg */
}

QMainWindow {
    background-color: transparent; /* Required for shadow effect */
}

/* The Main Background Container */
#mainContainer {
    background-color: #233140; /* @bg-darkest */
    border-radius: 20px;
    border: 1px solid #34495e; /* Subtle border definition */
}

/* --- PushButton Styling --- */
QPushButton {
    background-color: #3498db; /* @accent-blue */
    color: #ffffff;
    border: none;
    padding: 10px 18px;
    border-radius: 5px;
    margin: 4px;
}

QPushButton:hover {
    background-color: #4ea8e1;
}

QPushButton:pressed {
    background-color: #2980b9;
}

/* Specialized Buttons */
#runButton {
    background-color: #2ecc71; /* @accent-green */
}
#runButton:hover {
    background-color: #3fe380;
}
#runButton:pressed {
    background-color: #27ae60;
}

#deleteButton, #stopButton {
    background-color: #e74c3c; /* @accent-red */
}
#deleteButton:hover, #stopButton:hover {
    background-color: #f16a5c;
}
#deleteButton:pressed, #stopButton:pressed {
    background-color: #c0392b;
}

#restartButton {
    background-color: #f39c12; /* @accent-orange */
}
#restartButton:hover {
    background-color: #f5ab35;
}
#restartButton:pressed {
    background-color: #d35400;
}

#taskConfigButton {
    background-color: #34495e; /* @bg-medium */
    padding: 8px 15px;
}
#taskConfigButton:hover {
    background-color: #4a637a; /* @bg-light */
}


/* --- Input & View Styling --- */
QLineEdit, QPlainTextEdit {
    background-color: #34495e; /* @bg-medium */
    color: #ecf0f1;
    border: 1px solid #2c3e50; /* @bg-dark */
    padding: 10px;
    border-radius: 5px;
    margin: 4px;
}

QLineEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #3498db; /* @accent-blue */
}

QLabel {
    color: #ecf0f1;
    padding: 2px;
}

QStackedWidget {
    background-color: transparent;
    border: none;
}

/* --- List & Item View Styling --- */
QListWidget {
    background-color: #2c3e50; /* Needs explicit bg */
    border-radius: 8px;
    border: 1px solid #34495e;
    outline: none; /* Remove focus outline which can cause jitter */
}

QAbstractItemView::item {
    padding: 12px 10px;
    border-radius: 4px;
    border: 1px solid transparent; /* Reserve space for border to prevent jump */
}

QAbstractItemView::item:hover {
    background-color: #34495e; /* @bg-medium */
}

QAbstractItemView::item:selected {
    background-color: #3498db; /* @accent-blue */
    color: #ffffff;
}

/* ComboBox Styling */
QComboBox {
    background-color: #34495e;
    border: 1px solid #2c3e50;
    border-radius: 4px;
    padding: 8px;
    min-width: 6em;
}

QComboBox:editable {
    background-color: #2c3e50;
}

QComboBox:on { 
    padding-top: 3px;
    padding-left: 4px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 1px;
    border-left-color: #2c3e50;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

QComboBox::down-arrow {
    image: url(icons/down_arrow.png);
}

QComboBox QAbstractItemView {
    border: 1px solid #2c3e50;
    selection-background-color: #3498db;
}

/* CheckBox Styling */
QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
}

/* ScrollBar Styling */
QScrollBar:vertical {
    border: none;
    background: #2c3e50;
    width: 12px;
    margin: 0px 0px 0px 0px;
    border-radius: 6px;
}
QScrollBar::handle:vertical {
    background: #4a637a;
    min-height: 25px;
    border-radius: 6px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    border: none;
    background: #2c3e50;
    height: 12px;
    margin: 0px 0px 0px 0px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal {
    background: #4a637a;
    min-width: 25px;
    border-radius: 6px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* SpinBox Styling */
QSpinBox {
    padding-right: 15px; 
    border: 1px solid #2c3e50;
    border-radius: 4px;
    background-color: #34495e;
    color: #ecf0f1;
    padding: 8px;
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    height: 14px;
    border-left-width: 1px;
    border-left-color: #2c3e50;
    border-left-style: solid;
    border-top-right-radius: 3px;
    background: #4a637a;
    image: url(icons/up_arrow.png);
}
QSpinBox::up-button:hover {
    background: #5b7a97;
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    height: 14px;
    border-left-width: 1px;
    border-left-color: #2c3e50;
    border-left-style: solid;
    border-bottom-right-radius: 3px;
    background: #4a637a;
    image: url(icons/down_arrow.png);
}
QSpinBox::down-button:hover {
    background: #5b7a97;
}

/* --- Custom Title Bar Styles --- */
#customTitleBar {
    background-color: transparent; /* Title bar bg is now handled by container */
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
}
#customTitleBar QLabel {
    font-weight: bold;
    /* font-size removed */
}
#customTitleBar QPushButton {
    padding: 0;
    margin: 0;
    border: none;
    border-radius: 0px;
    background-color: transparent;
    /* font-size removed */
    font-weight: bold;
}
/* Ensure top-right corner of close button is rounded if it hits the edge */
#closeButton {
    border-top-right-radius: 20px;
}

#minimizeButton:hover, #maximizeButton:hover {
    background-color: #4a637a;
}
#closeButton:hover {
    background-color: #e74c3c; /* @accent-red */
}

/* Style for the sidebar toggle button to make it look like a list item */
#sidebarToggleButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    text-align: left; /* Default alignment */
    padding: 12px 10px;
}
#sidebarToggleButton:hover {
    background-color: #34495e;
}

/* --- Divider Line --- */
QFrame[frameShape="HLine"] {
    border: none;
    height: 1px;
    background-color: #34495e; /* @bg-medium */
}

/* --- MessageBox Styling --- */
QMessageBox {
    background-color: #2c3e50; /* @bg-dark */
    border: 1px solid #34495e;
    border-radius: 8px;
    min-width: 400px; /* Ensure enough width for text */
}

QMessageBox QLabel {
    color: #ecf0f1;
    /* font-size removed */
    padding: 10px;
}

QMessageBox QPushButton {
    background-color: #34495e; /* @bg-medium */
    color: #ecf0f1;
    border: 1px solid #2c3e50;
    padding: 6px 15px;
    border-radius: 4px;
    min-width: 80px;
}

QMessageBox QPushButton:hover {
    background-color: #4a637a; /* @bg-light */
}

QMessageBox QPushButton:pressed {
    background-color: #2980b9;
}